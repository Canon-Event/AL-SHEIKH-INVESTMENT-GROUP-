      "html": "<div class=\"ds-filters\" role=\"group\" aria-label=\"Filter gallery\"><button type=\"button\" aria-pressed=\"true\">All</button><button type=\"button\" aria-pressed=\"false\">Energy</button></div>",
      "css": ".ds-filters{display:flex;flex-wrap:wrap;gap:5px}.ds-filters button{border:0;border-radius:0;background:transparent;color:var(--ink,#101e26);padding:9px 14px;font:400 12px/1.65 Hanken,Arial,sans-serif;cursor:pointer;transition:background .2s,color .2s}.ds-filters button[aria-pressed=\"true\"]{background:var(--ink,#101e26);color:white}.ds-filters button:hover:not([aria-pressed=\"true\"]){background:#e3e5de}.ds-filters button:focus-visible{outline:2px solid #90612a;outline-offset:6px}@media(max-width:800px){.ds-filters button{font-size:11px;padding:9px 12px}}@media(max-width:540px){.ds-filters button{padding:9px 11px}}"
