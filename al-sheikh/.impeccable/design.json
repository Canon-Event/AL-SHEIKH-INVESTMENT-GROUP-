    {
      "name": "Brass Button",
      "kind": "button",
      "refersTo": "button-brass",
      "description": "Primary action on dark photographic sections.",
      "html": "<button class=\"ds-brass\" type=\"button\">Explore our businesses <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 12h15M13 5l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg></button>",
      "css": ".ds-brass{display:inline-flex;align-items:center;justify-content:space-between;gap:34px;min-height:57px;padding:16px 23px;font:500 14px/1.5 Hanken,Arial,sans-serif;border:0;border-radius:0;cursor:pointer;transition:background .25s,box-shadow .25s,color .25s;background:var(--brass,#c7a678);color:var(--ink,#101e26)}.ds-brass svg{width:23px;height:23px;transition:transform .35s cubic-bezier(.16,1,.3,1)}.ds-brass:hover{background:var(--brass-light,#dfc8a6)}.ds-brass:hover svg{transform:translateX(4px)}.ds-brass:focus-visible{outline:2px solid #90612a;outline-offset:6px}.ds-brass:disabled{opacity:.5;cursor:default}@media(prefers-reduced-motion:reduce){.ds-brass,.ds-brass svg{transition-duration:.01ms}}"
    },
    {
      "name": "Dark Button",
      "kind": "button",
      "refersTo": "button-dark",
      "description": "Solid action on pale or brass surfaces.",
      "html": "<button class=\"ds-dark\" type=\"button\">Prepare email enquiry <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg></button>",
      "css": ".ds-dark{display:inline-flex;align-items:center;justify-content:space-between;gap:34px;min-height:57px;padding:16px 23px;font:500 14px/1.5 Hanken,Arial,sans-serif;border:0;border-radius:0;cursor:pointer;transition:background .25s,box-shadow .25s,color .25s;background:var(--ink,#101e26);color:var(--paper,#f7f6f2)}.ds-dark svg{width:23px;height:23px;transition:transform .35s cubic-bezier(.16,1,.3,1)}.ds-dark:hover{background:#2d414b;box-shadow:0 7px 20px #101e2615}.ds-dark:hover svg{transform:translateX(4px)}.ds-dark:focus-visible{outline:2px solid #90612a;outline-offset:6px}.ds-dark:disabled{opacity:.5;cursor:default}@media(prefers-reduced-motion:reduce){.ds-dark,.ds-dark svg{transition-duration:.01ms}}"
    },
    {
      "name": "Text Link",
      "kind": "button",
      "refersTo": "text-link",
      "description": "Underlined secondary destination with a moving arrow.",
      "html": "<a class=\"ds-link\" href=\"/businesses/\">Explore our businesses <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 12h15M13 5l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg></a>",
      "css": ".ds-link{display:inline-flex;align-items:center;gap:25px;font:400 14px/1.4 Hanken,Arial,sans-serif;padding:7px 0;border:0;border-bottom:1px solid currentColor;background:none;color:var(--ink,#101e26);text-decoration:none;width:max-content;max-width:100%}.ds-link svg{width:22px;height:22px;transition:transform .35s cubic-bezier(.16,1,.3,1)}.ds-link:hover svg{transform:translateX(5px)}.ds-link:focus-visible{outline:2px solid #90612a;outline-offset:6px}@media(prefers-reduced-motion:reduce){.ds-link svg{transition-duration:.01ms}}"
    },
    {
      "name": "Enquiry Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Visible label above a native underlined field.",
      "html": "<div class=\"ds-field\"><label for=\"ds-full-name\">Full name <span>(required)</span></label><input id=\"ds-full-name\" name=\"name\" autocomplete=\"name\" required placeholder=\"Your full name\"></div>",
      "css": ".ds-field{font-family:Hanken,Arial,sans-serif;background:var(--stone,#eeede7);color:var(--ink,#101e26);max-width:400px}.ds-field label{display:block;font-size:12px;margin-bottom:8px}.ds-field label span{color:var(--muted,#5f6a6c);font-size:11px;margin-left:3px}.ds-field input{width:100%;max-width:100%;border:0;border-bottom:1px solid #a9b4ae;background:transparent;color:var(--ink,#101e26);font:400 13px/1.6 Hanken,Arial,sans-serif;padding:10px 0 11px;border-radius:0;min-height:44px;caret-color:#8d6536;transition:border-color .2s}.ds-field input::placeholder{color:#68716e;opacity:1}.ds-field input:focus{border-bottom-color:#8a6130}.ds-field input:focus-visible{outline:2px solid #90612a;outline-offset:2px}@media(max-width:540px){.ds-field input{font-size:16px}.ds-field label{font-size:12px}}"
    },
    {
      "name": "Business Navigation",
      "kind": "nav",
      "description": "Native details disclosure with normal division links.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"/about/\" aria-current=\"page\">The group</a><details class=\"ds-menu\"><summary>Our businesses <svg viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><path d=\"m4 6 4 4 4-4\" stroke=\"currentColor\" stroke-width=\"1.4\"/></svg></summary><div class=\"ds-menu-links\"><a href=\"/businesses/petroleum/\">Energy &amp; petroleum <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg></a><a href=\"/businesses/properties/\">Real estate <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg></a><a href=\"/businesses/\">Explore the group <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M4 12h15M13 5l7 7-7 7\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg></a></div></details><a href=\"/gallery/\">Our world</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:34px;background:var(--ink,#101e26);color:var(--paper,#f7f6f2);font:400 14px/1.65 Hanken,Arial,sans-serif;padding:20px}.ds-nav a{color:inherit;text-decoration:none}.ds-nav>a,.ds-menu summary{position:relative;padding:12px 0}.ds-nav>a:after,.ds-menu summary:after{content:\"\";height:1px;position:absolute;bottom:4px;left:0;right:100%;background:var(--brass,#c7a678);transition:right .3s cubic-bezier(.16,1,.3,1)}.ds-nav>a:hover:after,.ds-nav>a[aria-current]:after,.ds-menu[open] summary:after{right:0}.ds-menu{position:relative}.ds-menu summary{display:flex;align-items:center;gap:7px;cursor:pointer;list-style:none}.ds-menu summary::-webkit-details-marker{display:none}.ds-menu summary svg{width:14px;height:14px;transition:transform .25s}.ds-menu[open] summary svg{transform:rotate(180deg)}.ds-menu-links{background:var(--ink,#101e26);padding:20px;min-width:250px;box-shadow:0 24px 35px #0c151d26}.ds-menu-links a{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:13px 0;border-bottom:1px solid var(--light-line,#ffffff29);font-size:15px}.ds-menu-links svg{width:18px;height:18px}.ds-menu-links a:hover{color:var(--brass-light,#dfc8a6)}.ds-nav a:focus-visible,.ds-nav summary:focus-visible{outline:2px solid var(--brass-light,#dfc8a6);outline-offset:6px}@media(max-width:800px){.ds-nav{align-items:stretch;flex-direction:column;gap:0}.ds-menu-links{box-shadow:none;padding:0 0 20px}.ds-nav>a,.ds-menu summary{font-size:22px;line-height:1.4;padding:16px 0}}"
    },
